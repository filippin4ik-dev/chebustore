# ===== chebu store — серверные секреты =====
# Скопируйте в .env на СЕРВЕРЕ (cp .env.example .env) и заполните.
# Файл .env никогда не коммитится и не попадает в клиентские приложения.

DOMAIN=chebustore.ru
PUBLIC_URL=https://chebustore.ru
ACME_EMAIL=admin@chebustore.ru

# openssl rand -base64 32
POSTGRES_PASSWORD=

# Ключ для хэширования токенов сессий и одноразовых кодов. openssl rand -base64 48
SERVER_SECRET=

# Telegram: токен от @BotFather, имя бота без @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=chebustore_bot
TELEGRAM_USE_WEBHOOK=true
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Необязательно: ID закрытой группы админов, куда приходят чеки (иначе — в личку каждому админу/менеджеру с привязанным Telegram)
TELEGRAM_ADMIN_CHAT_ID=

# Почта для кодов входа (например, Яндекс 360: smtp.yandex.ru, 465, пароль приложения)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@chebustore.ru
SMTP_PASS=
MAIL_FROM=chebu store <no-reply@chebustore.ru>

# Кто автоматически получает роль ADMIN при входе (через запятую)
BOOTSTRAP_ADMIN_EMAILS=
BOOTSTRAP_ADMIN_TELEGRAM_IDS=
